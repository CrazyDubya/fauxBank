{
  "info": {
    "name": "fauxBank API",
    "description": "Mock banking system with full functionality and alphanumeric account numbers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phone\": \"555-0100\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"ssn\": \"123-45-6789\",\n  \"address\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"Anytown\",\n    \"state\": \"CA\",\n    \"zip\": \"12345\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/register",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/login",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "login"]
            }
          }
        },
        {
          "name": "Get Customer Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"checking\",\n  \"initialDeposit\": 5000,\n  \"options\": {\n    \"overdraftProtection\": true,\n    \"overdraftLimit\": 500\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountNumber}}"]
            }
          }
        },
        {
          "name": "Transfer Funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountNumber\": \"{{fromAccount}}\",\n  \"toAccountNumber\": \"{{toAccount}}\",\n  \"amount\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "transfer"]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Process ACH",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountNumber\": \"{{fromAccount}}\",\n  \"toAccountNumber\": \"{{toAccount}}\",\n  \"amount\": 500,\n  \"description\": \"ACH transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/ach",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "ach"]
            }
          }
        },
        {
          "name": "Process eCheck",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountNumber\": \"{{fromAccount}}\",\n  \"toAccountNumber\": \"{{toAccount}}\",\n  \"amount\": 250,\n  \"checkNumber\": \"1001\",\n  \"description\": \"Check payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/echeck",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "echeck"]
            }
          }
        },
        {
          "name": "Process Wire Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountNumber\": \"{{fromAccount}}\",\n  \"toAccountNumber\": \"{{toAccount}}\",\n  \"amount\": 5000,\n  \"description\": \"Wire transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/wire",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "wire"]
            }
          }
        }
      ]
    },
    {
      "name": "Credit",
      "item": [
        {
          "name": "Perform Credit Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/credit-check",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}", "credit-check"]
            }
          }
        },
        {
          "name": "Apply for Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"loanType\": \"personal\",\n  \"principal\": 10000,\n  \"termMonths\": 36,\n  \"interestRate\": 5.99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loans/apply",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "apply"]
            }
          }
        },
        {
          "name": "Apply for Credit Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"cardType\": \"visa\",\n  \"requestedLimit\": 5000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/credit-cards/apply",
              "host": ["{{baseUrl}}"],
              "path": ["credit-cards", "apply"]
            }
          }
        },
        {
          "name": "Charge Credit Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"{{cardNumber}}\",\n  \"amount\": 99.99,\n  \"merchantId\": \"MERCHANT-123\",\n  \"description\": \"Purchase\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/credit-cards/charge",
              "host": ["{{baseUrl}}"],
              "path": ["credit-cards", "charge"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountNumber",
      "value": "",
      "type": "string"
    },
    {
      "key": "fromAccount",
      "value": "",
      "type": "string"
    },
    {
      "key": "toAccount",
      "value": "",
      "type": "string"
    },
    {
      "key": "cardNumber",
      "value": "",
      "type": "string"
    }
  ]
}
