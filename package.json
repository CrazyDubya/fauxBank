{
  "name": "fauxbank",
  "version": "1.0.0",
  "description": "A fictional bank that is fully featured and functional offering all levels of service at the highest security. Agentic Run and will produce custom accounts for use in compatible fauxWeb sites",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:cloudflare": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply fauxbank-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply fauxbank-db",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit"
  },
