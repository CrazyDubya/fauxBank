    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "hono": "^4.6.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
